// ============================================
// FITTRACK — Firestore Security Rules
// ============================================
// Copy these rules to: Firebase Console > Firestore Database > Rules
//
// These rules ensure:
// - Only authenticated users can access data
// - Each user can ONLY read/write their own data
// - User A cannot see, modify, or delete User B's data
// - All private data is nested under /users/{userId}/

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All user data is strictly isolated
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared routines collection
    match /shared_routines/{sharedId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
